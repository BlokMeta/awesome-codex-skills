{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/domain": { "project": ["src/**/*.ts"] },
    "tooling/seed": { "entry": ["config.ts"] },
    "packages/contracts": {
      "entry": ["src/index.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    }
  }
}
