{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/domain": {
      "project": ["src/**/*.ts"]
    },
    "tooling/seed": {
      "entry": ["config.ts"]
    },
    "packages/tokens": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/i18n": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/api": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": [".storybook/*.{ts,tsx}", "src/**/*.stories.tsx", "test/*.d.ts"],
      "project": ["src/**/*.{ts,tsx}", ".storybook/**/*.{ts,tsx}", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "app/**/{page,layout,not-found,icon}.{ts,tsx,svg}",
        "proxy.ts",
        "playwright.config.ts",
        "e2e/**/*.spec.ts",
        "test/*.d.ts"
      ],
      "project": [
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "e2e/**/*.ts",
        "proxy.ts"
      ]
    }
  }
}
