{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/domain": {
      "project": ["src/**/*.ts"]
    },
    "tooling/seed": {
      "entry": ["config.ts"]
    },
    "packages/tokens": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/i18n": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/api": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
