{
  "name": "@heliograph/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "dependencies": {
    "@heliograph/contracts": "workspace:*",
    "@heliograph/domain": "workspace:*",
    "@heliograph/seed": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@orpc/nest": "catalog:",
    "fastify": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ulid": "catalog:",
    "@nestjs/schedule": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "better-auth": "catalog:",
    "@better-auth/expo": "catalog:",
    "@better-auth/passkey": "catalog:",
    "zod": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@fastify/otel": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@fastify/cors": "catalog:"
  },
  "devDependencies": {
    "@heliograph/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^3.2.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "drizzle-kit": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:"
  }
}
