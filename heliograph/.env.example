# Heliograph — ortam değişkenleri
# Kopyala: cp .env.example .env  (yerel)  |  Üretim/CI: Doppler (docs/14-operator-kurulum-listesi.md)
# Zorunlu olanlar [required], isteğe bağlılar [optional]. Uygulama açılışta eksikleri raporlar: pnpm doctor
# Gizli değerleri asla commit etme.

# ── Genel ────────────────────────────────────────────────────────────────────
HG_ENV=local                                  # local | staging | production
HG_LOG_LEVEL=debug                            # debug | info | warn | error
HG_PUBLIC_WEB_URL=http://localhost:3000       # [required] web paneli
HG_PUBLIC_API_URL=http://localhost:4000       # [required] API tabanı (OAuth callback'ler bunun altında)
HG_DEFAULT_LOCALE=tr                          # tr | en
HG_DEFAULT_TIMEZONE=Europe/Istanbul

# ── Uygulama gizli anahtarları (sen üret: openssl rand -base64 48) ───────────
HG_APP_SECRET=                                # [required] better-auth gizli anahtarı (≥32 karakter; `openssl rand -base64 48`)
HG_MOBILE_SCHEME=heliograph                   # [optional] Expo derin bağlantı şeması (trustedOrigins)
HG_AUTH_REQUIRE_EMAIL_VERIFICATION=false      # [optional] e-posta doğrulamadan giriş yasak (Resend bağlanınca true)
HG_ENCRYPTION_MASTER_KEY=                     # [required] platform token'larının zarf şifrelemesi; 32 bayt base64 (`openssl rand -base64 32`) — YEDEKLE
HG_WEBHOOK_SIGNING_SECRET=                    # [required] kendi webhook imzalarımız

# ── Veri katmanı ─────────────────────────────────────────────────────────────
HG_DATABASE_URL=postgres://heliograph:heliograph@localhost:5432/heliograph   # [required] pgvector kurulu Postgres 16; bağlanan rol tabloların sahibi olmalı (migration çalıştırır) — API her kiracı işleminde `SET LOCAL ROLE hg_app` ile RLS'e düşer
HG_DB_AUTO_MIGRATE=true                       # [optional] açılışta migration + tohum (prod'da false; `pnpm db:migrate` CI/CD adımı)
HG_TEST_DATABASE_URL=                          # [optional] entegrasyon testleri için Postgres; boşsa süreç içi PGlite kullanılır
HG_REDIS_URL=redis://localhost:6379           # [required]
HG_TEMPORAL_ADDRESS=localhost:7233            # [required]
HG_TEMPORAL_NAMESPACE=default
HG_TEMPORAL_API_KEY=                          # [optional] yalnızca Temporal Cloud

# ── Nesne depolama (S3 uyumlu; yerelde MinIO, üretimde Cloudflare R2) ────────
HG_S3_ENDPOINT=http://localhost:9000          # [required]
HG_S3_REGION=auto
HG_S3_BUCKET=heliograph-media                 # [required]
HG_S3_ACCESS_KEY_ID=minio                     # [required]
HG_S3_SECRET_ACCESS_KEY=minio12345            # [required]
HG_S3_PUBLIC_BASE_URL=http://localhost:9000/heliograph-media   # [required] önizleme URL tabanı

# ── Platformlar (docs/14 A3–A7) ──────────────────────────────────────────────
HG_META_APP_ID=                               # [required-for:instagram]
HG_META_APP_SECRET=                           # [required-for:instagram]
HG_META_WEBHOOK_VERIFY_TOKEN=                 # [required-for:instagram] sen üret
HG_THREADS_APP_ID=                            # [required-for:threads]
HG_THREADS_APP_SECRET=                        # [required-for:threads]
HG_TIKTOK_CLIENT_KEY=                         # [required-for:tiktok]
HG_TIKTOK_CLIENT_SECRET=                      # [required-for:tiktok]
HG_GOOGLE_CLIENT_ID=                          # [required-for:youtube]
HG_GOOGLE_CLIENT_SECRET=                      # [required-for:youtube]
HG_X_CLIENT_ID=                               # [required-for:x]
HG_X_CLIENT_SECRET=                           # [required-for:x]
HG_TELEGRAM_ALERT_BOT_TOKEN=                  # [optional] alarm botu; persona botları panelden bağlanır (Kanallar → Telegram)
HG_TELEGRAM_ALERT_CHAT_ID=                    # [optional] ilk /start'ta panel gösterir

# ── LLM ──────────────────────────────────────────────────────────────────────
HG_ANTHROPIC_API_KEY=                         # [required]
HG_LLM_WRITER_MODEL=claude-opus-5
HG_LLM_CLASSIFIER_MODEL=claude-sonnet-5
HG_LLM_BATCH_MODEL=claude-haiku-4-5
HG_OPENAI_API_KEY=                            # [optional] yedek LLM + whisper-1
HG_GOOGLE_AI_API_KEY=                         # [optional] Gemini / Imagen / Veo

# ── Ses, görsel, video ───────────────────────────────────────────────────────
HG_ELEVENLABS_API_KEY=                        # [required-for:video]
HG_FAL_API_KEY=                               # [required-for:video] FLUX / Kling / LoRA
HG_IDEOGRAM_API_KEY=                          # [optional] metinli kapaklar
HG_DEEPGRAM_API_KEY=                          # [optional] WhisperX yoksa altyazı
HG_WHISPERX_URL=http://localhost:8010         # [optional] self-host altyazı servisi
HG_RENDER_URL=http://localhost:8020           # [required-for:video] Remotion/FFmpeg/VHS render servisi

# ── Stok ve arama ────────────────────────────────────────────────────────────
HG_PEXELS_API_KEY=                            # [required-for:video]
HG_PIXABAY_API_KEY=                           # [optional]
HG_TAVILY_API_KEY=                            # [required] trend motoru anlık arama
HG_EXA_API_KEY=                               # [optional]
HG_HF_TOKEN=                                  # [optional] Hugging Face rate limit
HG_GITHUB_TOKEN=                              # [optional] GitHub rate limit

# ── E-posta ──────────────────────────────────────────────────────────────────
HG_RESEND_API_KEY=                            # [required] bildirim e-postaları
HG_RESEND_WEBHOOK_SECRET=                     # [optional] inbound e-posta
HG_EMAIL_FROM="Heliograph <noreply@example.com>"

# ── Ödeme (docs/15, docs/14 G4–G5) ─────────────────────────────────────────
HG_PADDLE_API_KEY=                            # [required-for:billing] MoR
HG_PADDLE_WEBHOOK_SECRET=                     # [required-for:billing]
HG_PADDLE_CLIENT_TOKEN=                       # [required-for:billing] istemci checkout token'ı (gizli değil ama env'de)
HG_PADDLE_ENV=sandbox                         # sandbox | production
HG_IYZICO_API_KEY=                            # [optional] faz 2, TRY
HG_IYZICO_SECRET=                             # [optional]
HG_POLAR_ACCESS_TOKEN=                        # [optional] ikinci MoR
HG_POLAR_WEBHOOK_SECRET=                      # [optional]
HG_REVENUECAT_API_KEY=                        # [required-for:mobile_iap]
HG_REVENUECAT_WEBHOOK_SECRET=                 # [required-for:mobile_iap]

# ── Gözlemlenebilirlik ───────────────────────────────────────────────────────
HG_SENTRY_DSN_API=                            # [optional]
HG_SENTRY_DSN_WEB=                            # [optional]
HG_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # [optional]
HG_OTEL_EXPORTER_OTLP_HEADERS=                # [optional] "Authorization=Basic ..."

# ── Bütçe kesicileri ─────────────────────────────────────────────────────────
HG_BUDGET_DAILY_USD=50                        # aşılınca üretim durur, alarm
HG_BUDGET_MONTHLY_USD=1000
HG_KILL_PUBLISH=0                             # 1 → tüm yayınlar durur (acil)

# ── Mobil (apps/mobile, EXPO_PUBLIC_ öneki istemciye açıktır, gizli koyma) ───
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SENTRY_DSN=
