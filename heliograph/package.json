{
  "name": "heliograph",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "vitest",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "knip": "knip",
    "i18n:check": "turbo run i18n:check",
    "doctor": "tsx tooling/scripts/doctor.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm boundaries && pnpm knip",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "knip": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
