{
  "name": "@heliograph/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./props": {
      "types": "./dist/props/index.d.ts",
      "import": "./dist/props/index.js"
    },
    "./styles.css": "./src/web/styles.css"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet -o storybook-static"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@heliograph/tokens": "workspace:*",
    "@tanstack/react-virtual": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@heliograph/config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^3.2.0",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:"
  }
}
