{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"] },
      "body": { "$value": ["Instrument Sans", "system-ui", "sans-serif"] },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" },
      "sm": { "$value": "13px" },
      "md": { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "22px" },
      "2xl": { "$value": "28px" },
      "3xl": { "$value": "36px" },
      "4xl": { "$value": "48px" }
    },
    "lineHeight": {
      "$type": "dimension",
      "xs": { "$value": "16px" },
      "sm": { "$value": "18px" },
      "md": { "$value": "20px" },
      "base": { "$value": "24px" },
      "lg": { "$value": "26px" },
      "xl": { "$value": "28px" },
      "2xl": { "$value": "34px" },
      "3xl": { "$value": "40px" },
      "4xl": { "$value": "52px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "tracking": {
      "$type": "dimension",
      "label": { "$value": "0.06em", "$description": "Büyük harf etiketler" }
    }
  }
}
