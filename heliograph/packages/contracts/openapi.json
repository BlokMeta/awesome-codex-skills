{
  "info": {
    "title": "Heliograph API",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "system.health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "checkedAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "dependencies": {
                      "items": {
                        "properties": {
                          "detail": {
                            "type": "string"
                          },
                          "latencyMs": {
                            "maximum": 9007199254740991,
                            "minimum": 0,
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "status": {
                            "enum": [
                              "ok",
                              "degraded",
                              "down"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "status"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "staleConfigKeys": {
                      "maximum": 9007199254740991,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "degraded",
                        "down"
                      ],
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "checkedAt",
                    "dependencies",
                    "staleConfigKeys"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Liveness + dependency health",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/health/config": {
      "get": {
        "operationId": "system.configHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "checkedAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "stale": {
                      "items": {
                        "properties": {
                          "key": {
                            "type": "string"
                          },
                          "maxAgeDays": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer"
                          },
                          "overdueDays": {
                            "maximum": 9007199254740991,
                            "minimum": -9007199254740991,
                            "type": "integer"
                          },
                          "verifiedAt": {
                            "format": "date-time",
                            "type": "string"
                          }
                        },
                        "required": [
                          "key",
                          "verifiedAt",
                          "maxAgeDays",
                          "overdueDays"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "checkedAt",
                    "stale"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Stale dynamic-config keys (ADR-0011)",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "identity.me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "activeWorkspaceId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "operator": {
                      "properties": {
                        "email": {
                          "type": "string"
                        },
                        "emailVerified": {
                          "type": "boolean"
                        },
                        "id": {
                          "type": "string"
                        },
                        "locale": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "timezone": {
                          "type": "string"
                        },
                        "twoFactorEnabled": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "email",
                        "name",
                        "emailVerified",
                        "locale",
                        "timezone",
                        "twoFactorEnabled"
                      ],
                      "type": "object"
                    },
                    "workspaces": {
                      "items": {
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "role": {
                            "enum": [
                              "owner",
                              "admin",
                              "editor",
                              "viewer"
                            ],
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "slug",
                          "role"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "operator",
                    "workspaces",
                    "activeWorkspaceId"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Current operator, memberships and active workspace",
        "tags": [
          "identity"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
